#. Plugin Name of the plugin
#: disciple-tools-autolink.php
msgid "Disciple.Tools - Autolink"
msgstr "Disciple.Tools - Autolink"

#. Plugin URI of the plugin
#: disciple-tools-autolink.php
msgid "https://github.com/DiscipleTools/disciple-tools-autolink"
msgstr "https://github.com/DiscipleTools/disciple-tools-autolink"

#. Description of the plugin
#: disciple-tools-autolink.php
msgid ""
"Provides a simplified interface for managing and visualizing your Disciple."
"Tools network. Share access with your downstream leaders to easily build "
"your group tree."
msgstr ""
"Proporciona una interfaz simplificada para administrar y visualizar su red "
"Disciple.Tools. Comparta el acceso con sus líderes descendentes para "
"construir fácilmente su árbol de grupo."

#. Author URI of the plugin
#: disciple-tools-autolink.php
msgid "https://www.eastwest.org/"
msgstr "https://www.eastwest.org/"

