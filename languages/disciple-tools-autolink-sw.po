msgid "Disciple.Tools - Autolink"
msgstr "Zana za Wanafunzi - Kiunganishi kiotomatiki"

#. Plugin URI of the plugin
#: disciple-tools-autolink.php
msgid "https://github.com/DiscipleTools/disciple-tools-autolink"
msgstr "https://github.com/DiscipleTools/disciple-tools-autolink"

#. Description of the plugin
#: disciple-tools-autolink.php
msgid ""
"Provides a simplified interface for managing and visualizing your Disciple."
"Tools network. Share access with your downstream leaders to easily build "
"your group tree."
msgstr ""
"Hutoa kiolesura kilichorahisishwa cha kudhibiti na kuibua mtandao wako wa "
"Disciple.Tools. Shiriki ufikiaji na viongozi wako wa chini ili kuunda mti wa "
"kikundi chako kwa urahisi."

#. Author URI of the plugin
#: disciple-tools-autolink.php
msgid "https://www.eastwest.org/"
